@startuml
' The same hostile names on the other side, plus an end edge so the encoding's
' guarded SKIP is covered too.
state "init" as init
init: step
state "vm-idle" as vm-idle
vm-idle: and
[*] --> init : both are set initially
init --> vm-idle : tau ; step is positive ; and' is step
vm-idle --> init : choose(a product) ; true ; step' is and
vm-idle --> [*] : nothing is left
@enduml
