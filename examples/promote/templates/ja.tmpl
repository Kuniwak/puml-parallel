{{/*
  The Japanese gloss of the builtins promotion writes. Pass it with
  -template. A template is named after a builtin word and given the
  builtin's terms as .Args and, for @at, its state as .State; its gloss is a
  line comment above the edge, so it never replaces the builtin. The
  builtins left out are not glossed.
*/}}
{{define "in"}}{{index .Args 0}} は {{index .Args 1}} にある{{end}}
{{define "notin"}}{{index .Args 0}} は {{index .Args 1}} にない{{end}}
{{define "at"}}{{index .Args 0}} は〈{{.State}}〉{{end}}
{{define "frame"}}{{index .Args 0}} は {{index .Args 1}} の{{range $i, $k := .Args}}{{if ge $i 2}} {{$k}}{{end}}{{end}} 以外を変えない{{end}}
{{define "update"}}{{index .Args 0}} は {{index .Args 1}} の {{index .Args 2}} を {{index .Args 3}} にしたもの{{end}}
{{define "empty"}}{{index .Args 0}} は空{{end}}
{{define "eq"}}{{index .Args 0}} は {{index .Args 1}} と等しい{{end}}
{{define "ne"}}{{index .Args 0}} は {{index .Args 1}} と異なる{{end}}
