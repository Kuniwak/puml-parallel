@startuml AUDIT
' CSDF-IGNORE-BEGIN
!ifndef PROMOTED
title 監査 1 件のライフサイクル
!endif
' CSDF-IGNORE-END

state "未着手" as audIdle
state "調査中" as audOpen
audOpen : target ; 対象の口座ID
state "報告済み" as audDone
audDone : target ; 対象の口座ID

[*] --> audIdle

audIdle --> audOpen : AUDIT_BEGIN?口座ID ; ; $target' は $口座ID
audOpen --> audDone : AUDIT_REPORT ; ; $target' は $target
audDone --> audIdle : AUDIT_ARCHIVE
@enduml
