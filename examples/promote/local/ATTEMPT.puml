@startuml ATTEMPT
' One attempt at a job. A stuck attempt is replaced by a new one that asks a
' higher priority, so the family can grow without bound; whether it stops is not a
' property of any one step, which is why the global diagram states it as an
' assumption rather than a constrain.
state "未登録" as attNone
state "投入済み" as attSent
attSent : 優先度 ; Nat
state "滞留" as attStuck
attStuck : 優先度 ; Nat
state "完了" as attDone
attDone : 優先度 ; Nat

[*] --> attNone
attNone --> attSent : SUBMIT?新規ジョブ ; ; $優先度' = $新規ジョブ の優先度
attNone --> attSent : RESUBMIT?再投入ジョブ ; ; $優先度' = $再投入ジョブ の優先度
attSent --> attStuck : PENDING ; ; $優先度' = $優先度
attSent --> attDone : DONE ; ; $優先度' = $優先度
attStuck --> attDone : DONE ; ; $優先度' = $優先度
note as attemptChannels
  channel RESUBMIT : Resubmission
  channel SUBMIT : NewJob
end note
@enduml
