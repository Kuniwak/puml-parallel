@startuml ATTEMPT
' One transaction attempt. A stuck attempt is replaced by a new one that pays a
' higher fee, so the family can grow without bound; whether it stops is not a
' property of any one step, which is why the global diagram states it as an
' assumption rather than a constrain.
state "未登録" as attNone
state "送信済み" as attSent
attSent : 手数料
state "滞留" as attStuck
attStuck : 手数料
state "確定" as attConfirmed
attConfirmed : 手数料

[*] --> attNone
attNone --> attSent : SEND?未署名Tx ; true ; 手数料' = 未署名Tx の手数料
attNone --> attSent : RESEND?置換Tx ; true ; 手数料' = 置換Tx の手数料
attSent --> attStuck : PENDING ; true ; 手数料' = 手数料
attSent --> attConfirmed : CONFIRMED ; true ; 手数料' = 手数料
attStuck --> attConfirmed : CONFIRMED ; true ; 手数料' = 手数料
@enduml
