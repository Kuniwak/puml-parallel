@startuml USER
' One user opening and closing. The start state means that no such user
' exists: JOIN brings one in, closed; then OPEN and CLOSE alternate.
' CSDF-IGNORE-BEGIN
!ifndef PROMOTED
title 利用者 1 人の開け閉め
!endif
' CSDF-IGNORE-END

state "未参加" as usrNone
state "閉" as usrClosed
state "開" as usrOpened

[*] --> usrNone

usrNone --> usrClosed : JOIN
usrClosed --> usrOpened : OPEN
usrOpened --> usrClosed : CLOSE
@enduml
