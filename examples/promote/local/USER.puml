@startuml USER
' One user playing ping-pong. The start state means that no such user
' exists: JOIN brings one in, then PING and PONG alternate for ever.
' CSDF-IGNORE-BEGIN
!ifndef PROMOTED
title 利用者 1 人のピンポン
!endif
' CSDF-IGNORE-END

state "未参加" as usrNone
state "待機中" as usrIdle
state "返答待ち" as usrWaiting

[*] --> usrNone

usrNone --> usrIdle : JOIN
usrIdle --> usrWaiting : PING
usrWaiting --> usrIdle : PONG
@enduml
