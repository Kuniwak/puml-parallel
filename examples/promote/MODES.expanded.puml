@startuml
state "縮退中" as degraded
degraded : members ; MemberId ⇸ Member
degraded : reviews ; ReviewId ⇸ Review
state "稼働中" as running
running : members ; MemberId ⇸ Member
running : reviews ; ReviewId ⇸ Review
[*] --> running : @empty(members') ∧ @empty(reviews')
degraded --> degraded : CLOSE?会員ID ; @at(members[会員ID], memActive) ∧ ${members[会員ID].checkouts} が 0 ; @frame(members', members, 会員ID) ∧ @notin(会員ID, members') ∧ @eq(reviews', reviews)
degraded --> degraded : OPEN?会員ID ; @notin(会員ID, members) ; @frame(members', members, 会員ID) ∧ @at(members'[会員ID], memActive) ∧ ${members'[会員ID].checkouts} は 0 ∧ @eq(reviews', reviews)
degraded --> running : RECOVER ; ; @eq(members', members) ∧ @eq(reviews', reviews)
degraded --> degraded : RESUME?会員ID ; @at(members[会員ID], memSuspended) ; @frame(members', members, 会員ID) ∧ @at(members'[会員ID], memActive) ∧ ${members'[会員ID].checkouts} は ${members[会員ID].checkouts} ∧ @eq(reviews', reviews)
degraded --> degraded : SUSPEND?会員ID?理由 ; @at(members[会員ID], memActive) ; @frame(members', members, 会員ID) ∧ @at(members'[会員ID], memSuspended) ∧ ${members'[会員ID].reason} は $理由 ∧ ${members'[会員ID].checkouts} は ${members[会員ID].checkouts} ∧ @eq(reviews', reviews)
running --> running : CLOSE?会員ID ; @at(members[会員ID], memActive) ∧ ${members[会員ID].checkouts} が 0 ; @frame(members', members, 会員ID) ∧ @notin(会員ID, members') ∧ @eq(reviews', reviews)
running --> degraded : DEGRADE ; ; @eq(members', members) ∧ @eq(reviews', reviews)
running --> running : OPEN?会員ID ; @notin(会員ID, members) ; @frame(members', members, 会員ID) ∧ @at(members'[会員ID], memActive) ∧ ${members'[会員ID].checkouts} は 0 ∧ @eq(reviews', reviews)
running --> running : RESUME?会員ID ; @at(members[会員ID], memSuspended) ; @frame(members', members, 会員ID) ∧ @at(members'[会員ID], memActive) ∧ ${members'[会員ID].checkouts} は ${members[会員ID].checkouts} ∧ @eq(reviews', reviews)
running --> running : REVIEW_ARCHIVE?審査ID ; @at(reviews[審査ID], revDone) ; @eq(members', members) ∧ @frame(reviews', reviews, 審査ID) ∧ @notin(審査ID, reviews')
running --> running : REVIEW_BEGIN?審査ID?会員ID ; @notin(審査ID, reviews) ∧ $会員ID は $members の定義域にある ; @eq(members', members) ∧ @frame(reviews', reviews, 審査ID) ∧ @at(reviews'[審査ID], revOpen) ∧ ${reviews'[審査ID].target} は $会員ID
running --> running : REVIEW_REPORT?審査ID ; @at(reviews[審査ID], revOpen) ; @eq(members', members) ∧ @frame(reviews', reviews, 審査ID) ∧ @at(reviews'[審査ID], revDone) ∧ ${reviews'[審査ID].target} は ${reviews[審査ID].target}
running --> running : SUSPEND?会員ID?理由 ; @at(members[会員ID], memActive) ; @frame(members', members, 会員ID) ∧ @at(members'[会員ID], memSuspended) ∧ ${members'[会員ID].reason} は $理由 ∧ ${members'[会員ID].checkouts} は ${members[会員ID].checkouts} ∧ @eq(reviews', reviews)
note as channels
  channel CLOSE : MemberId
  channel OPEN : MemberId
  channel RESUME : MemberId
  channel REVIEW_ARCHIVE : ReviewId
  channel REVIEW_BEGIN : ReviewId.MemberId
  channel REVIEW_REPORT : ReviewId
  channel SUSPEND : MemberId.SuspendReason
end note
@enduml
