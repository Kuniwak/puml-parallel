@startuml
state "稼働中" as running
running : attempts
[*] --> running : @empty(attempts')
running --> running : CONFIRMED?試行ID ; @at(attempts[試行ID], attSent) ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attConfirmed) ∧ ${attempts'[試行ID].手数料} = ${attempts[試行ID].手数料}
running --> running : CONFIRMED?試行ID ; @at(attempts[試行ID], attStuck) ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attConfirmed) ∧ ${attempts'[試行ID].手数料} = ${attempts[試行ID].手数料}
running --> running : PENDING?試行ID ; @at(attempts[試行ID], attSent) ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attStuck) ∧ ${attempts'[試行ID].手数料} = ${attempts[試行ID].手数料}
running --> running : RESEND?試行ID?置換Tx ; @notin(試行ID, attempts) ∧ $置換Tx の置換元 は〈滞留〉にあり、$置換Tx の手数料 > 置換元 の手数料 ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attSent) ∧ ${attempts'[試行ID].手数料} = $置換Tx の手数料
running --> running : SEND?試行ID?未署名Tx ; @notin(試行ID, attempts) ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attSent) ∧ ${attempts'[試行ID].手数料} = $未署名Tx の手数料
note as fair
  assume 手数料を上げた置換を続ければ、いつかいずれかの試行が〈確定〉になる
end note
@enduml
