@startuml
state "稼働中" as running
running : attempts ; AttemptId ⇸ Attempt
[*] --> running : @empty(attempts')
running --> running : DONE?試行ID ; @at(attempts[試行ID], attSent) ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attDone) ∧ ${attempts'[試行ID].優先度} = ${attempts[試行ID].優先度}
running --> running : DONE?試行ID ; @at(attempts[試行ID], attStuck) ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attDone) ∧ ${attempts'[試行ID].優先度} = ${attempts[試行ID].優先度}
running --> running : PENDING?試行ID ; @at(attempts[試行ID], attSent) ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attStuck) ∧ ${attempts'[試行ID].優先度} = ${attempts[試行ID].優先度}
running --> running : RESUBMIT?試行ID?再投入ジョブ ; @notin(試行ID, attempts) ∧ $再投入ジョブ の置換元 は〈滞留〉にあり、$再投入ジョブ の優先度 > 置換元 の優先度 ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attSent) ∧ ${attempts'[試行ID].優先度} = $再投入ジョブ の優先度
running --> running : SUBMIT?試行ID?新規ジョブ ; @notin(試行ID, attempts) ; @frame(attempts', attempts, 試行ID) ∧ @at(attempts'[試行ID], attSent) ∧ ${attempts'[試行ID].優先度} = $新規ジョブ の優先度
note as fair
  assume 優先度を上げた置換を続ければ、いつかいずれかの試行が〈完了〉になる
end note
note as channels
  channel DONE : AttemptId
  channel PENDING : AttemptId
  channel RESUBMIT : AttemptId.Resubmission
  channel SUBMIT : AttemptId.NewJob
end note
@enduml
