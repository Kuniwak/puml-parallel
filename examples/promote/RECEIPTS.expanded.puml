@startuml
state "稼働中" as running
running : cycles ; Date ⇸ Cycle
running : receipts ; ReceiptId ⇸ Receipt
[*] --> running : @empty(cycles') ∧ @empty(receipts')
running --> running : LOG?入荷ID?基準日?数量 ; @at(cycles[基準日], cycCounting) ∧ @at(receipts[入荷ID], rcvReceived) ∧ $基準日 は $入荷ID の入荷日である ; @frame(cycles', cycles, 基準日) ∧ @at(cycles'[基準日], cycCounting) ∧ ${cycles'[基準日].total} = ${cycles[基準日].total} + $数量 ∧ @frame(receipts', receipts, 入荷ID) ∧ @at(receipts'[入荷ID], rcvLogged) ∧ ${receipts'[入荷ID].qty} は ${receipts[入荷ID].qty}
running --> running : LOG?入荷ID?基準日?数量 ; @notin(基準日, cycles) ∧ @at(receipts[入荷ID], rcvReceived) ∧ $基準日 は $入荷ID の入荷日である ; @frame(cycles', cycles, 基準日) ∧ @at(cycles'[基準日], cycCounting) ∧ ${cycles'[基準日].total} は $数量 ∧ @frame(receipts', receipts, 入荷ID) ∧ @at(receipts'[入荷ID], rcvLogged) ∧ ${receipts'[入荷ID].qty} は ${receipts[入荷ID].qty}
running --> running : RECEIVE?入荷ID?数量 ; @notin(入荷ID, receipts) ∧ $数量 は箱入数の倍数である ; @eq(cycles', cycles) ∧ @frame(receipts', receipts, 入荷ID) ∧ @at(receipts'[入荷ID], rcvReceived) ∧ ${receipts'[入荷ID].qty} は $数量
running --> running : REPORT?基準日 ; @at(cycles[基準日], cycFixed) ; @frame(cycles', cycles, 基準日) ∧ @notin(基準日, cycles') ∧ @eq(receipts', receipts)
running --> running : SHELVE?入荷ID ; @at(receipts[入荷ID], rcvLogged) ; @eq(cycles', cycles) ∧ @frame(receipts', receipts, 入荷ID) ∧ @notin(入荷ID, receipts')
running --> running : tau ; @exists(基準日 : Date) (@at(cycles[基準日], cycCounting)) ; @exists(基準日 : Date) (@at(cycles[基準日], cycCounting) ∧ @frame(cycles', cycles, 基準日) ∧ @at(cycles'[基準日], cycFixed) ∧ ${cycles'[基準日].total} は ${cycles[基準日].total} ∧ @eq(receipts', receipts))
note as channels
  channel LOG : ReceiptId.Date.Quantity
  channel RECEIVE : ReceiptId.Quantity
  channel REPORT : Date
  channel SHELVE : ReceiptId
end note
@enduml
