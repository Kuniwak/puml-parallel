@startuml

state "userIdle" as userIdle
userIdle : wanted ; ProductSet
state "userGonnaBuy" as userGonnaBuy
userGonnaBuy : product ; Product
state "userPaying" as userPaying
userPaying : product ; Product
state "userChoosing" as userChoosing
userChoosing : product ; Product
state "userWaiting" as userWaiting

[*] --> userIdle : $wanted' is empty
userIdle --> userIdle : tau ; ; $wanted' is non-empty
userIdle --> userGonnaBuy : showAvailable?products ; $products and $wanted have overlap ; $product' is one of the overlap between $products and $wanted
userGonnaBuy --> userPaying : insert?coin ; ; $product' is $product
userPaying --> userGonnaBuy : showPurchasable?products ; $products does not contain $product ; $product' is $product
userPaying --> userChoosing : showPurchasable?products ; $products contains $product ; $product' is $product
userChoosing --> userWaiting : choose!product
userWaiting --> userIdle : drop?product ; ; $wanted' is empty

note as channels
  channel choose : Product
  channel drop : Product
  channel insert : Coin
  channel showAvailable : ProductSet
  channel showPurchasable : ProductSet
end note
@enduml
