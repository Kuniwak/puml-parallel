@startuml

state "vmIdle" as vmIdle
vmIdle: availableProducts
state "vmCoinsInserted" as vmCoinsInserted
vmCoinsInserted: availableProducts
vmCoinsInserted: coins
state "vmWaitingChoosing" as vmWaitingChoosing
vmWaitingChoosing: availableProducts
vmWaitingChoosing: coins
state "vmDropping" as vmDropping
vmDropping: availableProducts
vmDropping: product

[*] --> vmIdle : availableProducts' are products initially in the vending machine
vmIdle --> vmIdle : showAvailable!availableProducts ; ; availableProducts' remains the same
vmIdle --> vmCoinsInserted : insert?coin ; ; coins' is {coin}, availableProducts' remains the same
vmCoinsInserted --> vmWaitingChoosing : showPurchasable?purchasableProducts ; ; availableProducts' and coins' remain the same
vmWaitingChoosing --> vmCoinsInserted : insert?coin ; ; coins' is coins with coin added, availableProducts' remains the same
vmWaitingChoosing --> vmDropping : choose?product ; availableProducts contains product ; product' is product
vmDropping --> vmIdle : drop?product ; ; availableProducts' is availableProducts minus product

@enduml
