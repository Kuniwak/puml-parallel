@startuml

state "vmIdle" as vmIdle
vmIdle : availableProducts ; ProductSet
state "vmCoinsInserted" as vmCoinsInserted
vmCoinsInserted : availableProducts ; ProductSet
vmCoinsInserted : coins ; CoinSet
state "vmWaitingChoosing" as vmWaitingChoosing
vmWaitingChoosing : availableProducts ; ProductSet
vmWaitingChoosing : coins ; CoinSet
state "vmDropping" as vmDropping
vmDropping : availableProducts ; ProductSet
vmDropping : dispensing ; Product

[*] --> vmIdle : $availableProducts' are products initially in the vending machine
vmIdle --> vmIdle : showAvailable!availableProducts ; ; $availableProducts' is $availableProducts
vmIdle --> vmCoinsInserted : insert?coin ; ; $coins' is the set of $coin ∧ $availableProducts' is $availableProducts
vmCoinsInserted --> vmWaitingChoosing : showPurchasable?purchasableProducts ; ; $availableProducts' is $availableProducts ∧ $coins' is $coins
vmWaitingChoosing --> vmCoinsInserted : insert?coin ; ; $coins' is $coins with $coin added ∧ $availableProducts' is $availableProducts
vmWaitingChoosing --> vmDropping : choose?product ; $availableProducts contains $product ; $dispensing' is $product
vmDropping --> vmIdle : drop?product ; $product is $dispensing ; $availableProducts' is $availableProducts minus $product

note as channels
  channel choose : Product
  channel drop : Product
  channel insert : Coin
  channel showAvailable : ProductSet
  channel showPurchasable : ProductSet
end note
@enduml
