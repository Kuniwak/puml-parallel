@startuml
' examples/valid/client_server.puml with every clause written in Python.
' client_server_formal_defs.py names the constants and the types. The prose
' speaks of a map of servers no state holds; here the one server is SERVER,
' and a client may give up waiting for it (tau) at any time. Give
' client_server.puml to csdfreplweb -prose to show its clauses.
state "clientReady(tools) || serverCallingToolsList" as c1_s4
c1_s4 : server ; Server
c1_s4 : tools ; ToolSet
c1_s4 : state ; ServerState
state "clientInitializing(serverStateMap, tools) || serverNotInitialized" as c0_s1
c0_s1 : server ; Server
c0_s1 : tools ; ToolSet
c0_s1 : state ; ServerState
state "clientReady(tools) || serverNotInitialized" as c1_s1
c1_s1 : server ; Server
c1_s1 : tools ; ToolSet
c1_s1 : state ; ServerState
state "clientInitializing(serverStateMap, tools) || serverInitialized" as c0_s3
c0_s3 : server ; Server
c0_s3 : tools ; ToolSet
c0_s3 : state ; ServerState
state "clientReady(tools) || serverInitialized" as c1_s3
c1_s3 : server ; Server
c1_s3 : tools ; ToolSet
c1_s3 : state ; ServerState
state "clientProcessing(tools) || serverCallingToolsList" as c2_s4
c2_s4 : server ; Server
c2_s4 : tools ; ToolSet
c2_s4 : state ; ServerState
state "clientProcessing(tools) || serverNotRunning" as c2_s0
c2_s0 : server ; Server
c2_s0 : tools ; ToolSet
state "clientInitializing(serverStateMap, tools) || serverInitializing" as c0_s2
c0_s2 : server ; Server
c0_s2 : tools ; ToolSet
c0_s2 : state ; ServerState
state "clientProcessing(tools) || serverInitialized" as c2_s3
c2_s3 : server ; Server
c2_s3 : tools ; ToolSet
c2_s3 : state ; ServerState
state "clientProcessing(tools) || serverInitializing" as c2_s2
c2_s2 : server ; Server
c2_s2 : tools ; ToolSet
c2_s2 : state ; ServerState
state "clientInitializing(serverStateMap, tools) || serverNotRunning" as c0_s0
c0_s0 : server ; Server
c0_s0 : tools ; ToolSet
state "clientReady(tools) || serverNotRunning" as c1_s0
c1_s0 : server ; Server
c1_s0 : tools ; ToolSet
state "clientProcessing(tools) || serverNotInitialized" as c2_s1
c2_s1 : server ; Server
c2_s1 : tools ; ToolSet
c2_s1 : state ; ServerState
state "clientReady(tools) || serverInitializing" as c1_s2
c1_s2 : server ; Server
c1_s2 : tools ; ToolSet
c1_s2 : state ; ServerState
state "clientCallingMCPServer(tools) || serverCallingToolsCall" as c3_s5
c3_s5 : server ; Server
c3_s5 : tools ; ToolSet
c3_s5 : state ; ServerState
state "clientInitializing(serverStateMap, tools) || serverCallingToolsList" as c0_s4
c0_s4 : server ; Server
c0_s4 : tools ; ToolSet
c0_s4 : state ; ServerState
[*] --> c0_s0 : $server' == SERVER ∧ $tools' == set()
c0_s0 --> c1_s0 : tau ; ; @eq(server', server) ∧ @eq(tools', tools)
c0_s0 --> c0_s1 : start ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ $state' == INITIAL
c1_s0 --> c2_s0 : inputPrompt ; ; @eq(server', server) ∧ @eq(tools', tools)
c0_s1 --> c1_s1 : tau ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c0_s1 --> c0_s2 : initializeReq ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c2_s0 --> c1_s0 : returnText ; ; @eq(server', server) ∧ @eq(tools', tools)
c1_s1 --> c2_s1 : inputPrompt ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c0_s2 --> c0_s3 : initializeRes ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c0_s2 --> c1_s2 : tau ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c2_s1 --> c1_s1 : returnText ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c0_s3 --> c1_s3 : tau ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c0_s3 --> c0_s4 : toolsListReq ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c1_s2 --> c2_s2 : inputPrompt ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c1_s3 --> c2_s3 : inputPrompt ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c0_s4 --> c0_s3 : toolsListRes ; ; @eq(server', server) ∧ $tools' == TOOLS ∧ @eq(state', state)
c0_s4 --> c1_s4 : tau ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c2_s2 --> c1_s2 : returnText ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c2_s3 --> c1_s3 : returnText ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c2_s3 --> c3_s5 : toolsCallReq ; $tools != set() ; @eq(server', server) ∧ @eq(tools', tools) ∧ $state' in STATES
c1_s4 --> c2_s4 : inputPrompt ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
c3_s5 --> c2_s3 : toolsCallRes ; $tools != set() ; @eq(server', server) ∧ @eq(tools', tools) ∧ $state' in STATES
c2_s4 --> c1_s4 : returnText ; ; @eq(server', server) ∧ @eq(tools', tools) ∧ @eq(state', state)
@enduml
