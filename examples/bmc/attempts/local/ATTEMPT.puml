@startuml ATTEMPT
' One attempt at a job, its atoms written in Python. A local clause reads
' the event's fields and the instance's own variables, and a local post gives
' the instance's variables after the step.
state "未登録" as attNone
state "投入済み" as attSent
attSent : 優先度 ; Nat
state "滞留" as attStuck
attStuck : 優先度 ; Nat
state "完了" as attDone
attDone : 優先度 ; Nat

[*] --> attNone
attNone --> attSent : SUBMIT?新規ジョブ ; ; $優先度' == $新規ジョブ.優先度
attNone --> attSent : RESUBMIT?再投入ジョブ ; ; $優先度' == $再投入ジョブ.優先度
attSent --> attStuck : PENDING ; ; @eq(優先度', 優先度)
attSent --> attDone : DONE ; ; @eq(優先度', 優先度)
attStuck --> attDone : DONE ; ; @eq(優先度', 優先度)
note as attemptChannels
  channel RESUBMIT : Resubmission
  channel SUBMIT : NewJob
end note
@enduml
